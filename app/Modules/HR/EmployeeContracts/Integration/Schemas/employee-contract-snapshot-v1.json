{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:laravel12-erp:hr:employee-contract-snapshot:v1",
    "title": "EmployeeContractSnapshotV1",
    "type": "object",
    "required": [
        "schemaVersion",
        "employeeId",
        "contractId",
        "employmentTypeCode",
        "validFrom",
        "validUntil",
        "capturedAt"
    ],
    "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "employeeId": { "type": "integer", "minimum": 1 },
        "contractId": { "type": "integer", "minimum": 1 },
        "employmentTypeCode": { "type": "string", "minLength": 1 },
        "validFrom": { "type": "string", "format": "date" },
        "validUntil": { "type": ["string", "null"], "format": "date" },
        "capturedAt": { "type": "string", "format": "date-time" }
    },
    "additionalProperties": false
}
