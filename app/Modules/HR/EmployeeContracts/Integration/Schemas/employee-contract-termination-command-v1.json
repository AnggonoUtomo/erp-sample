{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EmployeeContractTerminationCommandV1",
    "type": "object",
    "properties": {
        "schemaVersion": { "const": 1 },
        "contractId": { "type": "integer", "minimum": 1 },
        "employeeId": { "type": "integer", "minimum": 1 },
        "expectedState": { "const": "ACTIVE" },
        "effectiveDate": { "type": "string", "format": "date" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "actorUserId": { "type": "integer", "minimum": 1 }
    },
    "required": [
        "schemaVersion",
        "contractId",
        "employeeId",
        "expectedState",
        "effectiveDate",
        "reason",
        "actorUserId"
    ],
    "additionalProperties": false
}
