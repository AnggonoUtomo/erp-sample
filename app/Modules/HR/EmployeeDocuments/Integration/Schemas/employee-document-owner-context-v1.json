{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:laravel12-erp:hr:employee-document-owner-context:v1",
    "title": "EmployeeDocumentOwnerContextV1",
    "type": "object",
    "required": ["schemaVersion", "domain", "aggregateType", "aggregateId"],
    "additionalProperties": false,
    "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "domain": { "type": "string", "const": "HR" },
        "aggregateType": { "type": "string", "const": "EmployeeDocument" },
        "aggregateId": { "type": "string", "pattern": "^[1-9][0-9]*$" }
    },
    "$defs": {
        "documentReference": { "type": "string", "minLength": 1, "maxLength": 255 },
        "documentReferenceDescriptor": {
            "type": "object",
            "required": ["schemaVersion", "reference", "state"],
            "additionalProperties": false,
            "properties": {
                "schemaVersion": { "type": "integer", "const": 1 },
                "reference": { "$ref": "#/$defs/documentReference" },
                "state": { "enum": ["AVAILABLE", "MISSING", "ARCHIVED", "UNAVAILABLE", "DENIED"] }
            }
        }
    }
}
