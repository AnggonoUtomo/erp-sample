{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laravel12-erp.local/schemas/hr/offboardings/employee-offboarding-completed-v1.json",
  "title": "EmployeeOffboardingCompletedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "offboarding_id",
    "employee_id",
    "employee_contract_id",
    "target_employment_status_id",
    "exit_type",
    "effective_date",
    "business_date",
    "finalized_by_user_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "offboarding_id": {
      "type": "integer",
      "minimum": 1
    },
    "employee_id": {
      "type": "integer",
      "minimum": 1
    },
    "employee_contract_id": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "target_employment_status_id": {
      "type": "integer",
      "minimum": 1
    },
    "exit_type": {
      "type": "string",
      "enum": ["RESIGNATION", "TERMINATION", "END_OF_CONTRACT", "RETIREMENT", "OTHER"]
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "finalized_by_user_id": {
      "type": "integer",
      "minimum": 1
    }
  }
}
