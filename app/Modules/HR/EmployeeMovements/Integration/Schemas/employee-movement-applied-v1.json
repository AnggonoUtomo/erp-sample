{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laravel12-erp.local/schemas/hr/employee-movement-applied-v1.json",
  "title": "EmployeeMovementAppliedV1",
  "type": "object",
  "required": ["schemaVersion", "movementId", "employeeId", "movementType", "effectiveDate", "changedFields"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "movementId": { "type": "integer", "minimum": 1 },
    "employeeId": { "type": "integer", "minimum": 1 },
    "movementType": {
      "type": "string",
      "enum": ["TRANSFER", "PROMOTION", "DEMOTION", "EMPLOYMENT_CHANGE"]
    },
    "effectiveDate": { "type": "string", "format": "date" },
    "changedFields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "departement_id",
          "position_id",
          "job_level_id",
          "employment_status_id",
          "employment_type_id",
          "work_location_id",
          "supervisor_id"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "approvedBy": { "type": ["integer", "null"], "minimum": 1 },
    "appliedBy": { "type": ["integer", "null"], "minimum": 1 }
  }
}
