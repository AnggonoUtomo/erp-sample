{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:laravel12-erp:document-management:document-access-decision:v1",
    "title": "Document access decision v1",
    "type": "object",
    "required": ["schemaVersion", "reference", "action", "state"],
    "additionalProperties": false,
    "properties": {
        "schemaVersion": { "const": 1 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 255 },
        "action": { "type": "string", "minLength": 1, "maxLength": 32 },
        "state": { "enum": ["AVAILABLE", "MISSING", "ARCHIVED", "UNAVAILABLE", "DENIED"] }
    },
    "$defs": {
        "request": {
            "type": "object",
            "required": ["schemaVersion", "reference", "actorReference", "action", "expectedOwner"],
            "additionalProperties": false,
            "properties": {
                "schemaVersion": { "const": 1 },
                "reference": { "type": "string", "minLength": 1, "maxLength": 255 },
                "actorReference": { "type": ["string", "null"], "maxLength": 255 },
                "action": { "type": "string", "minLength": 1, "maxLength": 32 },
                "expectedOwner": { "$ref": "document-owner-context-v1.json" }
            }
        }
    }
}
