{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:laravel12-erp:document-management:document-owner-context:v1",
    "title": "Document owner context v1",
    "type": "object",
    "required": ["schemaVersion", "domain", "aggregateType", "aggregateId"],
    "additionalProperties": false,
    "properties": {
        "schemaVersion": { "const": 1 },
        "domain": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "aggregateType": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
        "aggregateId": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "$defs": {
        "documentReferenceDescriptor": {
            "type": "object",
            "required": ["schemaVersion", "reference", "state"],
            "additionalProperties": false,
            "properties": {
                "schemaVersion": { "const": 1 },
                "reference": { "type": "string", "minLength": 1, "maxLength": 255 },
                "state": {
                    "type": "string",
                    "enum": ["AVAILABLE", "MISSING", "ARCHIVED", "UNAVAILABLE", "DENIED"]
                }
            }
        }
    }
}
