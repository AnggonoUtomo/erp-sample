{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:laravel12-erp:document-management:document-ingestion:v1",
    "title": "Document ingestion gateway v1",
    "type": "object",
    "required": ["ownerContext", "uploadIntent", "actorReference", "stream"],
    "additionalProperties": false,
    "properties": {
        "ownerContext": { "$ref": "document-owner-context-v1.json" },
        "uploadIntent": {
            "type": "object",
            "required": ["filename", "declaredMediaType", "declaredByteSize", "idempotencyKey"],
            "additionalProperties": false,
            "properties": {
                "filename": { "type": "string", "minLength": 1, "maxLength": 255 },
                "declaredMediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
                "declaredByteSize": { "type": "integer", "minimum": 1, "maximum": 20971520 },
                "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 255 }
            }
        },
        "actorReference": { "type": "string", "minLength": 1, "maxLength": 255 },
        "stream": { "description": "Readable in-process stream; never serialized or persisted by the consumer." }
    },
    "$defs": {
        "result": {
            "type": "object",
            "required": ["schemaVersion", "reference", "version", "status", "scanStatus"],
            "additionalProperties": false,
            "properties": {
                "schemaVersion": { "const": 1 },
                "reference": { "type": "string", "minLength": 1, "maxLength": 255 },
                "version": { "type": "integer", "minimum": 1 },
                "status": { "const": "AVAILABLE" },
                "scanStatus": { "enum": ["NOT_CONFIGURED", "CLEAN"] }
            }
        }
    }
}
