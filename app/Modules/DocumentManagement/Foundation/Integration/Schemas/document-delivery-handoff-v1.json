{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:laravel12-erp:document-management:document-delivery-handoff:v1",
    "title": "Document delivery handoff v1",
    "type": "object",
    "required": ["schemaVersion", "reference", "action", "token", "expiresAt"],
    "additionalProperties": false,
    "properties": {
        "schemaVersion": { "const": 1 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 255 },
        "action": { "const": "DOWNLOAD" },
        "token": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]+$" },
        "expiresAt": { "type": "string", "format": "date-time" }
    }
}
